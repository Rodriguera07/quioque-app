rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function pointer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && pointer().orgId == orgId;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && pointer().role == 'admin';
    }

    // Ponteiro uid -> org/role. O próprio usuário pode ler o seu. Um admin
    // pode criar o ponteiro de um novo funcionário; ou o próprio usuário
    // pode criar o SEU (role admin), mas só apontando para uma organização
    // que ele mesmo acabou de criar (dono == ele) — é o que faz o
    // autocadastro funcionar sem permitir "sequestrar" uma org existente.
    // Nunca é alterado depois.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if (isOrgAdmin(request.resource.data.orgId)
          && request.resource.data.role in ['admin', 'staff'])
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid);
      allow update: if false;
      // Exclusão de conta pelo próprio usuário (LGPD, direito de eliminação).
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      // Autocadastro: qualquer usuário autenticado pode criar sua PRÓPRIA
      // organização nova (torna-se o dono/admin dela). "create" só funciona
      // se o documento ainda não existir, então não dá pra reescrever uma
      // org já criada por outra pessoa. Edição/exclusão continuam de fora
      // do app.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Perfis completos dos usuários da organização. Qualquer membro pode ler
    // o PRÓPRIO perfil (necessário para restaurar a sessão), mas listar toda
    // a equipe é exclusivo de admin — é isso que alimenta a tela de gestão
    // de usuários.
    match /organizations/{orgId}/users/{uid} {
      allow get: if isOrgMember(orgId) && (request.auth.uid == uid || isOrgAdmin(orgId));
      // Admin lista a equipe inteira (tela de gestão de usuários). Qualquer
      // membro também pode listar só a fatia de admins ativos — sem isso,
      // notifyAdmins() não consegue achar os tokens push dos admins quando
      // quem abre mesa/lança item/fecha mesa é um funcionário (não-admin), e
      // a notificação nunca sai. A query em getAdminPushTokens já filtra
      // exatamente por esses dois campos, então o Firestore consegue provar
      // que o resultado nunca extrapola essa fatia.
      allow list: if isOrgAdmin(orgId)
        || (isOrgMember(orgId) && resource.data.role == 'admin' && resource.data.active == true);
      // Só um admin cadastra novo usuário, e só com os campos esperados
      // (evita que o novo perfil já nasça "active: false" ou com papel
      // inválido, por exemplo) — ou o próprio usuário no autocadastro,
      // criando o perfil de admin da organização que ele mesmo criou.
      allow create: if (isOrgAdmin(orgId)
          && request.resource.data.uid == uid
          && request.resource.data.orgId == orgId
          && request.resource.data.role in ['admin', 'staff']
          && request.resource.data.active == true)
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.orgId == orgId
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true
            && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid);
      // Admin pode atualizar campos como "active", mas não pode alterar "role"
      // por aqui (evita auto-promoção); troca de papel fica fora do app por ora.
      // Qualquer usuário também pode gravar só o próprio token/assinatura de
      // notificação (necessário para registrar o dispositivo sem depender do
      // admin) — push nativo (expoPushToken) ou web push (webPushSubscription).
      allow update: if (isOrgAdmin(orgId)
          && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['expoPushToken', 'webPushSubscription']));
      // Exclusão de conta pelo próprio usuário (LGPD, direito de eliminação).
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Mesas — quadro ao vivo do dia. Qualquer membro opera mesas no dia a
    // dia (abrir, lançar item, registrar pagamento, fechar), mas os campos
    // de autoria não podem ser forjados em nome de outro usuário, e apagar
    // uma mesa (só acontece no encerramento do dia) é exclusivo de admin.
    match /organizations/{orgId}/tables/{tableId} {
      allow read: if isOrgMember(orgId);

      allow create: if isOrgMember(orgId)
        && request.resource.data.status == 'open'
        && request.resource.data.openedByUserId == request.auth.uid;

      allow update: if isOrgMember(orgId)
        && (request.resource.data.status != 'closed'
            || request.resource.data.closedByUserId == request.auth.uid);

      allow delete: if isOrgAdmin(orgId) && resource.data.status == 'closed';
    }

    // Vendas fechadas — histórico permanente, não editável nem apagável pelo
    // app. Quem assina o fechamento (closedByUserId) precisa ser o próprio
    // usuário autenticado, para o histórico de vendas não poder ser forjado
    // em nome de outra pessoa.
    match /organizations/{orgId}/closedSales/{saleId} {
      allow read: if isOrgMember(orgId);
      allow create: if isOrgMember(orgId)
        && request.resource.data.closedByUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // Rollups diários usados pelos Relatórios — só são gravados pelo
    // encerramento do dia, uma ação exclusiva de admin.
    match /organizations/{orgId}/daySummaries/{date} {
      allow read: if isOrgMember(orgId);
      allow create, update: if isOrgAdmin(orgId);
      allow delete: if false;
    }

    // Cardápio — qualquer membro lê (precisa pra lançar pedidos), só admin
    // edita (adicionar/remover itens, alterar valores).
    match /organizations/{orgId}/config/{docId} {
      allow read: if isOrgMember(orgId);
      allow create, update: if isOrgAdmin(orgId);
      allow delete: if false;
    }

    // Log de auditoria — qualquer usuário da organização pode gravar eventos
    // em seu próprio nome (é assim que suas próprias ações ficam auditadas),
    // mas a leitura é exclusiva de admin, já que o objetivo é o admin
    // acompanhar o que a equipe fez.
    match /organizations/{orgId}/auditLog/{entryId} {
      allow read: if isOrgAdmin(orgId);
      allow create: if isOrgMember(orgId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
